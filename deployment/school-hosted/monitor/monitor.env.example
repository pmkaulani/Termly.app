# Copy to /etc/termly/monitor.env and keep it owned by root with mode 0600.
# Defaults below assume the standard Termly Phase 2/3/5 school-hosted paths.
TERMLY_WEB_DIR=/opt/termly/app/deployment/school-hosted
TERMLY_WEB_COMPOSE_FILE=/opt/termly/app/deployment/school-hosted/compose.yml
TERMLY_WEB_ENV_FILE=/opt/termly/app/deployment/school-hosted/.env
TERMLY_BACKUP_ENV=/etc/termly/backup.env
TERMLY_HEALTHCHECK_SCRIPT=/opt/termly/app/scripts/healthcheck-school-hosted.sh
TERMLY_HEALTH_URL=
TERMLY_UPDATE_STATUS_FILE=/opt/termly/app/deployment/school-hosted/runtime/termly-update-status.json
TERMLY_HEALTH_STATUS_FILE=/opt/termly/app/deployment/school-hosted/runtime/termly-health-status.json
TERMLY_MONITOR_STATE_FILE=/var/lib/termly-monitor/state.json
HEALTHCHECK_TIMEOUT_SECONDS=150
ALERT_REPEAT_INTERVAL_MINUTES=60
ALERT_ON_RECOVERY=true

# Optional generic HTTPS webhook. The URL can contain a secret token; keep this file private.
# The monitor sends only a status and generic check labels, never credentials or healthcheck output.
TERMLY_ALERT_WEBHOOK_URL=
