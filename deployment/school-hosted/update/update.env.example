# Copy to /etc/termly/update.env. Own by root and chmod 0600.
# Paths below assume the Phase 2 Termly source checkout and Phase 3 backup scripts
# are installed on the school host. Adjust only after verifying your installation.
TERMLY_WEB_DIR=/opt/termly/app/deployment/school-hosted
SUPABASE_DIR=/opt/termly/supabase
TERMLY_RELEASE_PUBLIC_KEY_FILE=/etc/termly/release-public-key.pem
TERMLY_BACKUP_SCRIPT=/opt/termly/app/scripts/backup-school-hosted.sh
TERMLY_BACKUP_ENV=/etc/termly/backup.env
TERMLY_VERIFY_SCRIPT=/opt/termly/app/tools/releases/verify-release.mjs
