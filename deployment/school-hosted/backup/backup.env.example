# Copy to /etc/termly/backup.env and edit before installing the timer.
# This file is read by the backup and restore scripts. Keep it root-owned, mode 0600.
SUPABASE_DIR=/opt/termly/supabase
BACKUP_DIR=/mnt/termly-backups
# Plaintext working archives are staged here and deleted after encryption.
# Move this to a larger protected volume when databases are too large for /var/tmp.
BACKUP_TEMP_DIR=/var/tmp
# Optional but recommended: set this to the actual mounted filesystem path.
BACKUP_EXPECTED_MOUNT=/mnt/termly-backups

# Public age recipient only. Generate a key pair with:
#   age-keygen -o /root/termly-backup-identity.txt
#   age-keygen -y /root/termly-backup-identity.txt
# Keep the identity file offline/on a separate secure device. Put only the age1... recipient below.
AGE_RECIPIENT=age1REPLACE_WITH_YOUR_PUBLIC_RECIPIENT

# Keep encrypted local copies for this many days.
KEEP_DAYS=30

# Optional off-site target, e.g. school-backups:termly-school-a/ .
# Install and configure rclone separately. The remote must be independent of this server.
RCLONE_REMOTE=

# Optional newline-separated absolute paths to include in the encrypted archive.
# Useful for /etc/caddy/Caddyfile and the Termly runtime config.
EXTRA_CONFIG_PATHS_FILE=/etc/termly/backup-extra-paths.txt

# Optional Termly URL to verify from the server after backup/restore.
TERMLY_HEALTH_URL=

# Maximum age in hours for the latest local encrypted backup before health check warns/fails.
REQUIRE_RECENT_BACKUP_HOURS=30
