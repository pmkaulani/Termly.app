{
  "name": "termly",
  "private": true,
  "version": "1.0.1",
  "description": "School Management System for modern Kenya",
  "author": "Termly Team",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "electron:start": "vite build && electron .",
    "electron:build": "vite build && electron-builder",
    "electron:publish": "vite build && electron-builder --publish always",
    "cap:sync": "vite build && npx cap sync",
    "cap:open": "npx cap open android",
    "android:build": "vite build && npx cap sync android && cd android && gradlew.bat assembleDebug"
  },
  "build": {
    "appId": "com.termly.school",
    "productName": "Termly",
    "publish": [
      {
        "provider": "github",
        "owner": "Termly-app",
        "repo": "Termly.app",
        "releaseType": "draft"
      }
    ],
    "directories": {
      "output": "release"
    },
    "icon": "public/assets/pwa-512x512.png",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    },
    "win": {
      "target": "nsis"
    }
  },
  "dependencies": {
    "@babel/core": "^7.29.7",
    "@babel/helpers": "^8.0.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@sentry/react": "^10.67.0",
    "@supabase/supabase-js": "^2.99.1",
    "core-js": "^3.49.0",
    "dexie": "^4.3.0",
    "dompurify": "^3.4.13",
    "electron-updater": "^6.8.9",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "papaparse": "^5.5.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-easy-crop": "^6.2.3",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^6.20.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@vitejs/plugin-react": "^4.2.0",
    "@vitest/ui": "^1.0.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^22.1.0",
    "vite": "^5.0.0",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^1.0.0"
  }
}
